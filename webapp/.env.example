# Copy to .env for local dev. In production these are set as Vercel
# environment variables instead - this file is never read there.

FLASK_SECRET_KEY=change_me_to_a_random_64_char_hex_string
SENDER_EMAIL=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_google_app_password
ALLOWED_EMAIL=the_only_email_allowed_to_log_in@gmail.com

# Fine-grained GitHub PAT scoped to just the mime-state repo, Contents: Read and write.
GITHUB_TOKEN=github_pat_...

# From your Turso database dashboard / `turso db show <name>` and
# `turso db tokens create <name>`.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=
