# Ignore everything by default
*
*/

# Whitelist .gitignore and example files
!.gitignore
!README.md
!.env.example
!outreach_queue.example.csv
!requirements.txt

# Whitelist pipeline core scripts
!applicant.py
!apify_scraper.py
!config.py
!cover_letter_generator.py
!email_sender.py
!exa_search.py
!outreach_pipeline.py
!followup_pipeline.py

# Whitelist the scheduled CI workflow (contains no secrets, only references them)
!.github/
!.github/workflows/
!.github/workflows/daily-pipeline.yml

# Whitelist the triage dashboard webapp (secrets live in Vercel env vars, not here)
!webapp/
!webapp/*.py
!webapp/*.txt
!webapp/*.json
!webapp/*.md
!webapp/.env.example
!webapp/templates/
!webapp/templates/*.html
!webapp/api/
!webapp/api/*.py
