# API Keys for Lead Discovery & Enrichment
APIFY_API_TOKEN=your_apify_api_token_here
EXA_API_KEY=your_exa_api_key_here

# Sender Email Settings
# GMAIL_APP_PASSWORD is a 16-character Google App Password, not your login
# password. Requires 2-Step Verification: https://myaccount.google.com/apppasswords
# Paste it with or without the spaces Google shows - either works.
SENDER_EMAIL=your_gmail_address_here@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Applicant contact details, used on the cover letter letterhead and in the
# email signature. Kept out of applicant.py so that file can be committed to a
# public repository. Do not quote the values - they are read literally up to
# the end of the line. APPLICANT_EMAIL defaults to SENDER_EMAIL if left unset.
APPLICANT_PHONE=+000 00 000 0000
APPLICANT_EMAIL=your_gmail_address_here@gmail.com
